# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Domaine production
# APP_URL=https://reserve.marneza.com
# API_URL=https://reserve.marneza.com

# ─── MySQL (XAMPP) ─────────────────────────────────────────────
# Utilisateur par défaut XAMPP : root sans mot de passe
# Si vous avez un mot de passe : mysql://root:VOTRE_MDP@localhost:3306/marneza_reservation
DATABASE_URL=mysql://root@localhost:3306/marneza_reservation

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Réservation ───────────────────────────────────────────────
BOOKING_HOLD_MINUTES=15
BOOKING_LINK_EXPIRE_HOURS=24
DEFAULT_TIMEZONE=Africa/Kinshasa
DEFAULT_CURRENCY=USD

# ─── Auth admin (JWT) ──────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
REQUIRE_AUTH=true

# Compte admin initial (créé une seule fois par npm run db:seed)
# Le mot de passe n'est PAS réécrit si le compte existe déjà
ADMIN_EMAIL=admin@marneza.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NOTIFICATION_EMAIL=app@marneza.com

# ─── Email notification admin ───────────────────────────────────
# MAIL_MODE=preview  → gratuit, lien d'aperçu dans la console API (Ethereal)
# MAIL_MODE=mailtrap → API Mailtrap
# MAIL_MODE=smtp     → SMTP IONOS (TLS / STARTTLS sur le port 587)
MAIL_ENABLED=true
MAIL_MODE=smtp
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=app@marneza.com
SMTP_PASS=
SMTP_FROM=Marneza <app@marneza.com>
# MAILTRAP_TOKEN=
# MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co
# MAILTRAP_SENDER_NAME=Marneza
# MAILTRAP_USE_SANDBOX=false
# MAILTRAP_INBOX_ID=123456

# ─── Odoo (phase 2 — sync) ─────────────────────────────────────
ODOO_URL=https://marneza.odoo.com
ODOO_DB=marneza
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_SYNC_ENABLED=false

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://reserve.marneza.com,https://marneza.odoo.com
